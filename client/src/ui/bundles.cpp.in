// Generated by CMake from client/src/ui/strings/*.json; do not edit.
#include "ui/bundles.h"

namespace wb::ui {

std::string_view bundle_json(std::string_view lang) {
    if (lang == "cs") return R"wbjson(@WORKBENCH_UI_STRINGS_CS@)wbjson";
    if (lang == "de") return R"wbjson(@WORKBENCH_UI_STRINGS_DE@)wbjson";
    return R"wbjson(@WORKBENCH_UI_STRINGS_EN@)wbjson";
}

}  // namespace wb::ui
