#include <winver.h>

1 24 "@CMAKE_CURRENT_SOURCE_DIR@/app.manifest"

// The Workbench icon (improve-window-frame D4): File Explorer, the taskbar, the window and the tray.
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/workbench.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @WORKBENCH_VERSION_COMMAS@,0
PRODUCTVERSION @WORKBENCH_VERSION_COMMAS@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "SkoWork contributors"
      VALUE "FileDescription", "SkoWork"
      VALUE "FileVersion", "@WORKBENCH_VERSION@"
      VALUE "ProductName", "SkoWork"
      VALUE "ProductVersion", "@WORKBENCH_VERSION@ (@WORKBENCH_CHANNEL@, @WORKBENCH_COMMIT@)"
      VALUE "OriginalFilename", "SkoWork.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
