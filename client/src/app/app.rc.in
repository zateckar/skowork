#include <winver.h>

1 24 "@CMAKE_CURRENT_SOURCE_DIR@/app.manifest"

// The Skowork icon (improve-window-frame D4): File Explorer, the taskbar, the window and the tray.
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/skowork.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @SKOWORK_VERSION_COMMAS@,0
PRODUCTVERSION @SKOWORK_VERSION_COMMAS@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Skowork contributors"
      VALUE "FileDescription", "Skowork"
      VALUE "FileVersion", "@SKOWORK_VERSION@"
      VALUE "ProductName", "Skowork"
      VALUE "ProductVersion", "@SKOWORK_VERSION@ (@SKOWORK_CHANNEL@, @SKOWORK_COMMIT@)"
      VALUE "OriginalFilename", "Skowork.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
