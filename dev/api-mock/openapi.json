{
  "openapi": "3.1.0",
  "info": {
    "title": "Orders API (dev mock)",
    "version": "1.0.0",
    "description": "A small orders service used to test API connectors locally. It stores orders in memory and is never shipped."
  },
  "servers": [{ "url": "http://127.0.0.1:4010" }],
  "paths": {
    "/orders/{orderId}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Get one order",
        "description": "Returns one order by its identifier, with its lines, its status and its totals in the order currency.",
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }
        ],
        "responses": {
          "200": {
            "description": "The order.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
          },
          "404": { "description": "No order has this identifier." }
        }
      }
    },
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Create an order",
        "description": "Creates an order for a customer from a list of lines and returns the stored order with its new identifier.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewOrder" } } }
        },
        "responses": {
          "201": {
            "description": "The stored order.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
          },
          "400": { "description": "The request does not match the schema." }
        }
      }
    },
    "/legacy/status": {
      "get": {
        "operationId": "legacyStatus",
        "summary": "Service status",
        "description": "TODO",
        "responses": {
          "200": {
            "description": "The service status.",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string" } } } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Line": {
        "type": "object",
        "required": ["sku", "quantity"],
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      },
      "NewOrder": {
        "type": "object",
        "required": ["customerId", "lines"],
        "properties": {
          "customerId": { "type": "string", "minLength": 1 },
          "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/Line" } }
        }
      },
      "Order": {
        "type": "object",
        "required": ["id", "customerId", "status", "lines", "total"],
        "properties": {
          "id": { "type": "string" },
          "customerId": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "shipped", "cancelled"] },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/Line" } },
          "total": { "type": "number" }
        }
      }
    }
  }
}
