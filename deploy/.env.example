# SkoWork control plane settings for deploy/docker-compose.yml.
# Copy to deploy/.env (git-ignored) and fill in. Never commit real values.
# The startup log warns about every setting below that is missing.

# ---- Image ----------------------------------------------------------------------------------------------------
# latest (stable release), a version such as 0.1.0, or main (dev build).
WORKBENCH_VERSION=latest
# Host port the reverse proxy forwards to.
WORKBENCH_HTTP_PORT=8080

# ---- Public address (REQUIRED) -------------------------------------------------------------------------------
# The https address clients and admins use, as served by your reverse proxy. Registration hands clients service
# URLs under it; without it they are derived from the request (http:// behind a proxy), which clients refuse.
WORKBENCH_PUBLIC_BASE_URL=https://workbench.example.com

# ---- Identity provider (REQUIRED) ----------------------------------------------------------------------------
# OpenID Connect discovery document of the Keycloak realm. Must be https.
OIDC_DISCOVERY_URL=https://keycloak.example.com/realms/example/.well-known/openid-configuration
# Public client used by both the desktop clients and the admin console (Authorization Code with PKCE).
# Access tokens must carry it in "aud" (Keycloak: an Audience mapper on the client). See README.
OIDC_CLIENT_ID=workbench-desktop
# Admin console sign-in redirect. Empty = <WORKBENCH_PUBLIC_BASE_URL>/admin/ ; register it on the client.
WORKBENCH_ADMIN_REDIRECT_URI=
# preferred_username of the first platform admins, comma-separated. They assign further admins in the console.
WORKBENCH_BOOTSTRAP_ADMINS=

# ---- Secrets (REQUIRED) --------------------------------------------------------------------------------------
# Both are plain passphrases: type any long random text, for example four or five random words. No tools needed.
# Pseudonyms and crash-dump encryption. The control plane refuses to start without it.
WORKBENCH_TELEMETRY_SECRET=
# Encrypts LLM connection credentials at rest; at least 16 characters. Required as soon as an LLM connection exists.
# Keep it unchanged: with a different value, stored credentials cannot be read and must be entered again.
WORKBENCH_SECRET_KEY=

# ---- LLM (optional) ------------------------------------------------------------------------------------------
# OpenAI-compatible upstream used to create the first LLM connection. You can instead add connections in the
# admin console (LLM connections view). Without any, the gateway answers MODEL_UNAVAILABLE.
OPENAI_BASE_URL=
OPENAI_KEY=

# ---- Telemetry forwarding (optional) -------------------------------------------------------------------------
# OTLP/HTTP logs endpoint of the observability stack, and headers as "name=value,name=value".
WORKBENCH_TELEMETRY_FORWARD_URL=
WORKBENCH_TELEMETRY_FORWARD_HEADERS=
WORKBENCH_TELEMETRY_PSEUDONYMIZE=true
