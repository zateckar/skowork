# Copy this file to .env (git-ignored) and fill in your own values.
# Read by dev/scripts/dev-stack.ps1, the control plane (npm run dev) and the end-to-end tests only.
# Never commit real values or keys.

# LLM API (OpenAI-compatible): used by the end-to-end tests and test-real/.
OPENAI_BASE_URL=
OPENAI_KEY=
OPENAI_MODEL=

# OpenID Connect identity provider (Authorization Code with PKCE, public client).
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=http://localhost:4200/auth/callback
OIDC_SCOPE=openid profile email
